# PrintPoint backend environment variables
# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. NEVER commit real passwords, keys or connection strings.
# Every variable here is BACKEND-ONLY. None of them may be used in frontend code.
#
# Two separate Supabase projects are used:
#   printpoint-dev   -> your local backend/.env and Vercel "Preview"
#   printpoint-prod  -> Vercel "Production" only
# Never mix their credentials.

# ---------------------------------------------------------------------------
# DATABASE_URL - used by the running app
# ---------------------------------------------------------------------------
# Supabase: use the TRANSACTION pooler (port 6543).
# Supabase Dashboard -> Connect -> "Transaction pooler".
# If the password contains special characters (@ : / ? # %), URL-encode them.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Local development without Supabase (optional): comment the line above and use
# DATABASE_URL=sqlite:///./printpoint_dev.db

# ---------------------------------------------------------------------------
# MIGRATION_DATABASE_URL - used only by Alembic when you run migrations
# ---------------------------------------------------------------------------
# Use the SESSION pooler (port 5432). Supabase Dashboard -> Connect -> "Session pooler".
# If not set, Alembic falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Storage (private bucket for uploaded documents)
# Used for PDF/DOCX uploads (backend/storage.py). Bucket: print-documents (private).
# ---------------------------------------------------------------------------
# Dashboard -> Project Settings -> API. The SECRET / service_role key bypasses all
# security rules: it must only ever live here and in Vercel backend env vars.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-secret-key>
SUPABASE_STORAGE_BUCKET=print-documents

# ---------------------------------------------------------------------------
# CORS_ORIGINS - comma-separated list of frontend URLs allowed to call the API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication (backend only). Generate long random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use DIFFERENT values for development, Preview and Production.
# PASSWORD_PEPPER must never change once users exist (all passwords would break).
# ---------------------------------------------------------------------------
JWT_SECRET=<random-string-at-least-32-characters>
PASSWORD_PEPPER=<different-random-string-at-least-32-characters>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# false only for local http://localhost; always forced to true on Vercel (HTTPS)
COOKIE_SECURE=false
