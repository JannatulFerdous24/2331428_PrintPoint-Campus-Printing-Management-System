# Frontend settings (copy to .env.local). VITE_* values are PUBLIC: they are built
# into the JavaScript bundle, so never put secrets or keys here.

# Leave empty to call the API on the same origin (recommended: Vite proxy in dev,
# vercel.json rewrites in production). Only set it if the API is on another domain.
VITE_API_BASE_URL=

# Development only: where `npm run dev` forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
